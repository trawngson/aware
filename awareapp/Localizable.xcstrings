    "If it is already broken, wrap the pieces in paper or cardboard and write \"broken glass\" on it to protect collectors.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu đã vỡ, hãy gói các mảnh trong giấy hoặc bìa các-tông và ghi \"thủy tinh vỡ\" bên ngoài để người thu gom không bị thương."
          }
        }
      }
    },
    "If something isn't right": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If something isn't right"
          }
