    "Reuse the bag while it is still intact, for example as a bin liner for other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tái sử dụng túi khi còn nguyên vẹn, ví dụ làm túi lót thùng đựng chất thải khác."
          }
        }
      }
    },
    "Rinse the cup and stack it with other clean plastic cups.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tráng cốc và xếp chồng cùng các cốc nhựa sạch khác."
          }
        }
      }
    },
    "Scan one thing today to make it %lld days in a row.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan one thing today to make it %lld days in a row."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay quét một món để đạt %lld ngày liên tiếp."
          }
        }
      }
    },
    "Scan one thing today to start a recycling streak.": {
      "extractionState": "manual",
      "localizations": {
