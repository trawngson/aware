    "AWARE's sorting tips follow Hanoi's household waste sorting rules, which split waste into three groups, plus hazardous items kept apart.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẹo phân loại của AWARE dựa theo quy định phân loại rác sinh hoạt của Hà Nội: rác được chia thành ba nhóm, còn chất thải nguy hại được để riêng."
          }
        }
      }
    },
    "Add to Gallery": {
      "extractionState": "manual",
      "localizations": {
