            "state": "translated",
            "value": "Post not found"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bài đăng"
          }
        }
      }
    },
    "Posts that break these rules get hidden, and people who keep breaking them can't post anymore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts that break these rules get hidden, and people who keep breaking them can't post anymore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài vi phạm sẽ bị ẩn, và ai vi phạm nhiều lần sẽ không thể đăng bài nữa."
          }
        }
      }
    },
    "Pour out any liquid left inside.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ hết phần nước còn lại bên trong."
          }
        }
      }
    },
    "Put it in the green food-waste bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ vào túi màu xanh đựng chất thải thực phẩm."
          }
        }
      }
    },
    "Put it in the grey bag for other household waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ vào túi màu xám đựng chất thải sinh hoạt khác."
          }
        }
      }
    },
    "Put the foam cup in other waste.": {
      "extractionState": "manual",
