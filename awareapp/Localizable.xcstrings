    "Disposable cup": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cốc dùng một lần"
          }
        }
      }
    },
    "Do not put plastic bags in with recyclables. They get tangled in sorting and lower the value of the whole bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bỏ túi ni-lông lẫn vào rác tái chế. Túi dễ bị vướng khi phân loại và làm giảm giá trị của cả túi rác tái chế."
          }
        }
      }
    },
    "Drink or pour out what is left and rinse the cup.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống hết hoặc đổ phần còn lại rồi tráng cốc."
          }
        }
      }
    },
    "Empty the bottle or jar and rinse off food or drink.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ hết đồ bên trong chai, lọ và tráng sạch thức ăn hoặc đồ uống còn sót lại."
          }
        }
      }
    },
    "Empty the can completely and rinse it quickly.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ hết đồ bên trong và tráng nhanh lon."
          }
        }
      }
    },
    "Empty the cup and put any drink or food left in the green food-waste bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ hết cốc; đồ uống hoặc thức ăn còn lại bỏ vào túi màu xanh đựng chất thải thực phẩm."
          }
        }
      }
    },
    "Empty the cup. Tapioca pearls, jelly, and ice go in the green food-waste bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ hết cốc. Trân châu, thạch và đá bỏ vào túi màu xanh đựng chất thải thực phẩm."
          }
        }
      }
    },
    "Flatten the box and stack or tie flat boxes together.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gấp dẹt hộp, xếp chồng hoặc buộc các hộp đã gấp dẹt lại với nhau."
          }
        }
      }
    },
    "Foam": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xốp"
          }
        }
      }
    },
    "Food waste": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất thải thực phẩm"
          }
        }
      }
    },
    "For food tins, push the sharp lid inside the tin so nobody gets cut.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với hộp thiếc đựng thực phẩm, ấn nắp sắc vào bên trong hộp để không ai bị cứa tay."
          }
        }
      }
    },
    "For soap or shampoo pump bottles, unscrew the pump. The bottle is recyclable; the pump has a metal spring and goes in other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với chai xà phòng hoặc dầu gội có vòi bơm, hãy vặn tháo vòi bơm. Chai có thể tái chế; vòi bơm có lò xo kim loại nên bỏ vào chất thải khác."
          }
        }
      }
    },
    "Glass bottle or jar": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chai, lọ thủy tinh"
          }
        }
      }
    },
    "Glass bottles and jars are recyclable.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chai, lọ thủy tinh có thể tái chế."
          }
        }
      }
    },
