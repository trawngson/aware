    "It will be removed for everyone, with its photo and replies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed for everyone, with its photo and replies."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng sẽ bị xóa với mọi người, cùng ảnh và các bình luận."
          }
        }
      }
    },
    "It's mean or hurtful": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's mean or hurtful"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung ác ý hoặc gây tổn thương"
          }
        }
      }
    },
    "It's spam or an ad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's spam or an ad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam hoặc quảng cáo"
          }
        }
      }
    },
    "Items recycled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items recycled"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Món đã tái chế"
          }
        }
      }
    },
    "Just now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just now"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vừa xong"
          }
        }
      }
    },
    "Keep it about recycling, upcycling and caring for the planet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it about recycling, upcycling and caring for the planet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chia sẻ về tái chế, tái sử dụng và bảo vệ môi trường."
          }
        }
      }
    },
    "Keep it apart from all other waste in a sealed, leak-proof container and hand it over at a hazardous-waste collection point.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để riêng với mọi loại rác khác trong vật chứa kín, không rò rỉ và giao cho điểm thu gom chất thải nguy hại."
          }
        }
      }
    },
    "Keep it dry and out of the rain. Wet cardboard cannot be recycled.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khô ráo, tránh mưa. Bìa các-tông bị ướt không thể tái chế."
          }
        }
      }
    },
    "Keep it separate from food and other waste, then give or sell it to a scrap collector (ve chai, đồng nát).": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để riêng với chất thải thực phẩm và chất thải khác, rồi cho hoặc bán cho người thu mua ve chai, đồng nát."
          }
        }
      }
    },
    "Keep it whole. Do not break glass on purpose.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên vẹn, không cố ý đập vỡ thủy tinh."
          }
        }
      }
    },
    "Keep scanning to see your trend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
