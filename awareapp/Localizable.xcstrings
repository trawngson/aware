    "Bottles that held pesticides, strong chemicals, or motor oil are hazardous waste, not recyclables.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chai từng đựng thuốc bảo vệ thực vật, hóa chất mạnh hoặc dầu nhớt là chất thải nguy hại, không phải rác tái chế."
          }
        }
      }
    },
    "Break large foam blocks into smaller pieces so they fit in the bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bẻ các khối xốp lớn thành miếng nhỏ để vừa túi rác."
          }
        }
      }
    },
    "Cardboard": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bìa các-tông"
          }
        }
      }
    },
    "Carrying a reusable shopping bag avoids plastic bags altogether.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mang theo túi đi chợ dùng nhiều lần để không phải dùng túi ni-lông."
          }
        }
      }
    },
    "Change answer": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi câu trả lời"
          }
        }
      }
    },
    "Clean cardboard is recyclable. Greasy, wet, or food-stained cardboard isn't.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bìa các-tông sạch có thể tái chế. Bìa dính dầu mỡ, bị ướt hoặc dính thức ăn thì không."
          }
        }
      }
    },
    "Clean foam boxes are useful for storage. Choosing paper or reusable containers for takeaway avoids foam waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hộp xốp sạch có thể dùng để đựng đồ. Chọn hộp giấy hoặc hộp dùng nhiều lần khi mua đồ mang về sẽ tránh được rác xốp."
          }
        }
      }
    },
