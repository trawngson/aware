          "stringUnit": {
            "state": "translated",
            "value": "Scan something and it shows up here."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét một món đồ, nó sẽ hiện ở đây."
          }
        }
      }
    },
    "Scrape food scraps from foam boxes or trays into the green food-waste bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gạt thức ăn thừa trên hộp hoặc khay xốp vào túi màu xanh đựng chất thải thực phẩm."
          }
        }
      }
    },
    "Scrape food scraps into the green food-waste bag.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gạt thức ăn thừa vào túi màu xanh đựng chất thải thực phẩm."
          }
        }
      }
    },
    "See recycling ideas": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ý tưởng tái chế"
