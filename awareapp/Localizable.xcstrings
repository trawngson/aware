          "stringUnit": {
            "state": "translated",
            "value": "Scan one thing today to start a recycling streak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay quét một món để bắt đầu chuỗi ngày tái chế."
          }
