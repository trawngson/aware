    "Our community is a friendly place to share what you made. Before your first post, please agree to a few simple rules:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our community is a friendly place to share what you made. Before your first post, please agree to a few simple rules:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cộng đồng AWARE là nơi thân thiện để chia sẻ những gì bạn làm ra. Trước khi đăng bài đầu tiên, bạn hãy đồng ý với vài quy tắc đơn giản:"
          }
        }
      }
    },
    "Paper": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy"
          }
        }
      }
    },
    "Paper and hard plastic cups are recyclable. Foam cups aren't.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cốc giấy và cốc nhựa cứng có thể tái chế. Cốc xốp thì không."
          }
        }
      }
    },
    "Peel off the sealing film and remove the straw; both go in other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bóc màng dán miệng cốc và bỏ ống hút ra; cả hai đều bỏ vào chất thải khác."
          }
        }
      }
    },
    "Period": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng thời gian"
          }
        }
      }
    },
    "Plastic bag": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Túi ni-lông"
          }
        }
      }
    },
    "Plastic bags can't be recycled here, so they go in other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Túi ni-lông không tái chế được, nên bỏ vào chất thải khác."
          }
        }
      }
    },
    "Plastic bottle": {
