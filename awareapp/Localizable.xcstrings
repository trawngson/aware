        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này cần có kết nối internet. Hãy thử lại khi bạn có mạng nhé."
          }
        }
      }
    },
    "Tie several bags together into one bundle so they do not blow away.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buộc nhiều túi lại thành một bó để túi không bị gió thổi bay."
          }
        }
      }
    },
    "To get reminders and replies, allow notifications for AWARE in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get reminders and replies, allow notifications for AWARE in Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận lời nhắc và phản hồi, hãy cho phép AWARE gửi thông báo trong Cài đặt."
          }
        }
      }
    },
    "To put a post on the map, allow AWARE to use your location in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To put a post on the map, allow AWARE to use your location in Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đưa bài đăng lên bản đồ, hãy cho phép AWARE dùng vị trí trong Cài đặt."
          }
        }
      }
    },
    "To see projects near you, allow AWARE to use your location in Settings. The map works without it too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see projects near you, allow AWARE to use your location in Settings. The map works without it too."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem các dự án gần bạn, hãy cho phép AWARE dùng vị trí trong Cài đặt. Bản đồ vẫn dùng được khi không bật vị trí."
          }
        }
      }
    },
    "Try scanning it again, a little closer and in good light.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử quét lại gần hơn một chút và ở nơi đủ sáng."
          }
        }
      }
    },
    "Unblock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ chặn"
          }
        }
      }
    },
    "Want to give it a second life? See our recycling ideas below.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn cho nó một cuộc đời mới? Xem các ý tưởng tái chế của chúng mình bên dưới nhé."
          }
        }
      }
    },
    "We couldn't identify this item.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AWARE chưa nhận ra được vật này."
          }
        }
      }
    },
    "We'll take a look. You won't see it here anymore.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll take a look. You won't see it here anymore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng mình sẽ xem xét. Bạn sẽ không thấy nội dung này nữa."
          }
        }
      }
    },
    "What is the cup made of?": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cốc được làm bằng chất liệu gì?"
          }
        }
      }
    },
    "When you throw it away, shake out any food or liquid.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi vứt bỏ, hãy giũ sạch thức ăn hoặc chất lỏng còn bên trong."
          }
        }
      }
    },
    "Why are you reporting this?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why are you reporting this?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao bạn báo cáo nội dung này?"
          }
        }
      }
    },
    "Yes, clean and dry": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, sạch và khô"
          }
        }
      }
    },
    "You haven't blocked anyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't blocked anyone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa chặn ai."
          }
        }
      }
    },
    "You reached this month's goal. Nice work!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached this month's goal. Nice work!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt mục tiêu tháng này. Làm tốt lắm!"
          }
        }
      }
    },
    "You won't see their posts or replies anymore. You can unblock them in More.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't see their posts or replies anymore. You can unblock them in More."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không thấy bài đăng và bình luận của họ nữa. Bạn có thể bỏ chặn trong mục Thêm."
          }
        }
      }
    },
    "You're %lld leaves away from this month's goal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're %lld leaves away from this month's goal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn %lld lá nữa là đạt mục tiêu tháng này."
          }
        }
      }
    },
    "You're offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến"
          }
        }
      }
    },
    "Your account can't do that right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account can't do that right now."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn hiện chưa thể làm việc này."
          }
        }
      }
    },
    "Your posts show your display name, never your email or location. Photos you share can be seen by everyone using AWARE.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts show your display name, never your email or location. Photos you share can be seen by everyone using AWARE."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng của bạn chỉ hiện tên hiển thị, không bao giờ hiện email hay vị trí của bạn. Ảnh bạn chia sẻ thì mọi người dùng AWARE đều xem được."
          }
        }
      }
    },
    "^[%lld day](inflect: true)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld day](inflect: true)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ngày"
          }
        }
      }
    },
    "day": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "day"
          }
        },
        "vi": {
