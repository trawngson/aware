          "stringUnit": {
            "state": "translated",
            "value": "Bỏ cốc xốp vào chất thải khác."
          }
        }
      }
    },
    "Put the foam in other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ xốp vào chất thải khác."
          }
        }
      }
    },
    "Put the greasy or wet cardboard in other waste.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phần bìa dính dầu mỡ hoặc bị ướt vào chất thải khác."
          }
        }
      }
    },
    "Quickly rinse bottles that held milk, juice, or sweet drinks so they do not smell or attract insects.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tráng qua những chai từng đựng sữa, nước ép hoặc đồ uống ngọt để không bốc mùi hay thu hút côn trùng."
          }
        }
      }
    },
